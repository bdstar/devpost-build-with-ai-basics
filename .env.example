APP_NAME="GenAI Ratel CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Timestamps are stored in UTC and displayed in this timezone
APP_DISPLAY_TZ=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log

# Single demo administrator, created by `php artisan migrate --seed`.
# Demo-only placeholders: change them before using the app anywhere shared.
ADMIN_NAME="Demo Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-demo-only

# AI mode: "fixtures" (default, no API key, deterministic labelled outputs)
# or "live" (calls Gemini; requires GEMINI_API_KEY)
AI_MODE=fixtures
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Synthetic performance dataset (read-only; never written by the app)
SYNTHETIC_DATASET_PATH=aquariumpark_synthetic_demo/aquariumpark_synthetic_posts.json
